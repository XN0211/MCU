#include "ht32.h"
#include "BFTM0.h"
#include "USART0.h"
#include <string.h>
#include <stdio.h>

void delay_ms(u32 ms);

int main(void)
{
    #if (HTCFG_STACK_USAGE_ANALYSIS == 1)
    StackUsageAnalysisInit(0);
    #endif
    
    BFTM0_Configuration();
    USART0_Configuration();  // ?????? (PA8: TX ? PC, PA10: RX ? Device A)
    
    u8 rx_data;              
    u8 rx_state = 0;         
    u8 high_received = 0;    
    u16 restored_val = 0;    
    
    char print_str[64];      
    
    while (1)
    {
        if(HT_CKCU->APBCCR1 & (1 << 4))
            WDT_Restart();
        
        // 1. ?????????????????
        while (USART0_rx_data(&rx_data))
        {
            u8 header = rx_data & 0xC0; // ??????
            
            if (header == 0x40) // ??????? (01)
            {
                high_received = rx_data & 0x3F; 
                rx_state = 1;                   
            }
            else if (header == 0x80) // ??????? (10)
            {
                if (rx_state == 1) 
                {
                    u8 low_received = rx_data & 0x3F; 
                    restored_val = (high_received << 6) | low_received; // ???? 12-bit!
                }
                rx_state = 0; 
            }
            else 
            {
                rx_state = 0; // ????
            }
        }
        
        // 2. ????????? UART0 ???? (Tera Term)
        sprintf(print_str, "Restored ADC Value: %4d\r\n", (int)restored_val);
        USART0_tx_data((u8*)print_str, strlen(print_str));
        
        // 3. ??
        bftm0_ct = 0;
        while(bftm0_ct < 500)
        {
        }
    }
}

void delay_ms(u32 ms)
{
    volatile u32 i, j;
    for (i = 0; i < ms; i++)
    {
        for (j = 0; j < 1000; j++);
    }
}
