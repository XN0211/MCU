#include "ht32.h"
#include "EXTI.h"
#include "GPIO.h"
#include "GPTM0.h" // 需要用到計時器相關控制

// 宣告 main.c 中的 buzz 函式，讓 EXTI.c 也能呼叫它來發聲
extern void buzz(uint8_t enable, uint32_t duration_ms, uint32_t frequency);

// 指定歌曲（貝多芬）頻率陣列
int Beethoven[8] = {784, 784, 784, 622, 740, 740, 740, 587};

//-----------------------------------------------------------------------------
void EXTI_Configuration(void)
{
  EXTI_InitTypeDef EXTI_InitStruct = {0};
  CKCU_PeripClockConfig_TypeDef CKCUClock = {{ 0 }};
  
  // 開啟 EXTI 與 AFIO 時脈
  CKCUClock.Bit.EXTI    = 1;
  CKCUClock.Bit.AFIO    = 1;
  CKCU_PeripClockConfig(CKCUClock, ENABLE);

  // 設定 EXTI 通道 0 對應至 PD 腳位 (AFIO_ESS_PD)
  AFIO_EXTISourceConfig(AFIO_EXTI_CH_0, AFIO_ESS_PD);
  
  EXTI_InitStruct.EXTI_Debounce = EXTI_DEBOUNCE_DISABLE;
  EXTI_InitStruct.EXTI_DebounceCnt = 0;
  EXTI_InitStruct.EXTI_Channel = AFIO_EXTI_CH_0;
  EXTI_InitStruct.EXTI_IntType = EXTI_BOTH_EDGE; // 雙邊緣觸發
  EXTI_Init(&EXTI_InitStruct);
  
  EXTI_IntConfig(AFIO_EXTI_CH_0, ENABLE);

  // 開啟 EXTI0_1 中斷向量
  NVIC_EnableIRQ(EXTI0_1_IRQn);
}

//-----------------------------------------------------------------------------
void EXTI0_1_IRQHandler(void)
{
  // 檢查是否為負緣觸發 (按下按鈕)
  if (EXTI_GetEdgeStatus(EXTI_CHANNEL_0, EXTI_EDGE_NEGATIVE))
  {
      // 直接在獨立的中斷函式中播放指定歌曲
      int j;
      for (j = 0; j < 8; j++)
      {
          buzz(1, 200, Beethoven[j]); 
          buzz(0, 50, 0);             
      }
  }
  else
  {
      GPIO_WriteOutBits(HT_GPIOA, GPIO_PIN_2, 0);
  }

  // 清除中斷旗標
  EXTI_ClearEdgeFlag(EXTI_CHANNEL_0);
}
